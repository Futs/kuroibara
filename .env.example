# Application
APP_NAME=Kuroibara
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
SECRET_KEY=your_secret_key_here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_CONNECTION=postgresql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=kuroibara
DB_USERNAME=kuroibara
DB_PASSWORD=password

# Valkey (Redis)
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=null
VALKEY_DB=0

# JWT
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Email
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@kuroibara.app
MAIL_FROM_NAME="${APP_NAME}"

# 2FA
TWO_FA_ISSUER=Kuroibara

# Providers
# Optional: FlareSolverr URL for bypassing Cloudflare protection
# If not set, Cloudflare-protected providers will be disabled
# Example: FLARESOLVERR_URL=http://192.168.1.10:8191
FLARESOLVERR_URL=

# External Integrations (Optional)
# You can either set these environment variables OR configure them through the UI
# Anilist OAuth2 credentials (get from https://anilist.co/settings/developer)
# ANILIST_CLIENT_ID=
# ANILIST_CLIENT_SECRET=

# MyAnimeList OAuth2 credentials (get from https://myanimelist.net/apiconfig)
# MAL_CLIENT_ID=
# MAL_CLIENT_SECRET=

# Extension host API token (required). Use the same value for the backend, the source worker and the host.
# Generate a real one with:  openssl rand -hex 32   (64 hex characters)
# The host refuses to start with a token shorter than 32 characters or one that starts with CHANGE_ME.
# Example format only (not a real token):  EXTENSION_HOST_TOKEN=CHANGE_ME_generate_with_openssl_rand_hex_32
EXTENSION_HOST_TOKEN=CHANGE_ME_generate_with_openssl_rand_hex_32

# Server time zone (IANA name). Used for users without their own zone. Example: Europe/Amsterdam
TZ=UTC
